rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null && request.auth.uid == "n8r0xqMKGfRLV09emJ84p8JTWgb2";
  }
  match /config/catalogo {
   allow read: if true;
   allow write: if admin() && request.resource.data.keys().hasOnly(['items']) && request.resource.data.items is list && request.resource.data.items.size() <= 500;
  }
  match /pedidos/{id} {
   allow create: if request.auth != null
    && request.auth.token.firebase.sign_in_provider == "anonymous"
    && request.resource.data.keys().hasOnly(['customer','phone','items','total','status','createdAt','sourceUid'])
    && request.resource.data.customer is string
    && request.resource.data.customer.size() > 0
    && request.resource.data.customer.size() <= 100
    && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
    && request.resource.data.items is list && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 40
    && request.resource.data.total is number && request.resource.data.total >= 0
    && request.resource.data.status == 'Aguardando pagamento'
    && request.resource.data.sourceUid == request.auth.uid
    && request.resource.data.createdAt == request.time;
   allow get, list, update, delete: if admin();
  }
 }
}